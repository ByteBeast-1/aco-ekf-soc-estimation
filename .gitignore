# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Compiled C / C++ binaries
*.exe
*.out
*.o
*.obj
*.app

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# MATLAB/Simulink: the shared algorithm library must be tracked despite the generic "lib/" rule above
!simulink_matlab/lib/
# Simulink / MATLAB build caches (regenerated automatically)
slprj/
*.slxc
*.autosave
*.asv
codegen/

# Trained model weights (reproduced by python/main_ultimate.py)
models/*.pth

# Third-party copyrighted paper - keep local only
docs/references/*.pdf

# Generated Word documents (generate on demand via python/convert_notes_to_docx.py)
*.docx
